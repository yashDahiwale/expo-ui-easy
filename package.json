{
  "name": "expo-ui-easy-monorepo",
  "private": true,
  "description": "Typed React Native wrappers for Expo UI's Jetpack Compose components (Android).",
  "workspaces": [
    "packages/*",
    "example",
    "docs"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:bench",
    "generate": "npm run generate -w expo-ui-easy",
    "build": "npm run build -w expo-ui-easy",
    "example": "npm run android -w example",
    "example:tunnel": "npm run tunnel -w example",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "bench": "node e2e/bench/run.mjs",
    "test:bench": "node --test e2e/bench/lib.test.mjs",
    "e2e": "maestro test e2e/flows",
    "docs": "npm run dev -w expo-ui-easy-docs",
    "docs:build": "npm run build -w expo-ui-easy-docs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
