{
  "name": "expo-ui-easy-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate-docs.mjs",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "postinstall": "fumadocs-mdx",
    "pretypecheck": "npm run generate"
  },
  "dependencies": {
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.5",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.5",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
