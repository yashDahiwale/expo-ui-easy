{
  "name": "expo-ui-easy",
  "version": "0.0.0",
  "description": "Typed React Native wrappers for Expo UI's Jetpack Compose components (Android).",
  "license": "MIT",
  "keywords": [
    "react-native",
    "expo",
    "expo-ui",
    "jetpack-compose",
    "material3",
    "android"
  ],
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "bob build",
    "clean": "del-cli lib"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "peerDependencies": {
    "@expo/ui": ">=58.0.28 <59.0.0",
    "expo": ">=58.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@expo/ui": "^58.0.28",
    "@types/react": "~19.2.0",
    "del-cli": "^8.0.1",
    "expo": "~58.0.0",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-worklets": "^0.13.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.7"
  }
}
